<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:BattleSim.Domain.Enums;assembly=BattleSim.Domain"
        x:Class="BattleSim.App.Views.MainWindow"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        Title="BattleSim">
  <TabControl Margin="16">
    <TabItem Header="Battle">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,320" ColumnSpacing="16" RowSpacing="16">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Run Next Attack" Command="{Binding RunNextAttackCommand}" />
      <Button Content="Run Next Turn" Command="{Binding RunNextTurnCommand}" />
      <Button Content="Run One Round" Command="{Binding RunOneRoundCommand}" />
      <Button Content="Reset Battle" Command="{Binding ResetBattleCommand}" />
      <TextBlock Text="{Binding RoundLabel}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" x:Name="BattleGridLayer">
      <Grid x:Name="BattleGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16" RowSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Blue Side" FontSize="18" FontWeight="SemiBold" />
          <Button Content="Rotate" Command="{Binding RotateLeftFormationCommand}" IsEnabled="{Binding CanRotateFormations}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Red Side" FontSize="18" FontWeight="SemiBold" />
          <Button Content="Rotate" Command="{Binding RotateRightFormationCommand}" IsEnabled="{Binding CanRotateFormations}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding LeftLoadedUnitName}"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding UnitTemplateOptions}"
                    SelectedItem="{Binding SelectedLeftUnitTemplate, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeUnitTemplates}"
                    Width="170" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding RightLoadedUnitName}"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding UnitTemplateOptions}"
                    SelectedItem="{Binding SelectedRightUnitTemplate, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeUnitTemplates}"
                    Width="170" />
        </Grid>

        <ItemsControl x:Name="LeftFormationGrid" Grid.Row="2" ItemsSource="{Binding LeftGridCells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="3" Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{Binding BorderBrush}"
                      BorderThickness="{Binding BorderThickness}"
                      MinHeight="132"
                      Padding="5"
                      Background="{Binding BackgroundBrush}"
                      PointerPressed="OnGridCellPointerPressed"
                      PointerMoved="OnGridCellPointerMoved"
                      PointerReleased="OnGridCellPointerReleased">
                <StackPanel Spacing="2" HorizontalAlignment="Center" IsVisible="{Binding HasTroop}">
                  <TextBlock Text="{Binding Name}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  <Border BorderBrush="{Binding PortraitBorderBrush}"
                          BorderThickness="{Binding PortraitBorderThickness}"
                          IsVisible="{Binding HasPortrait}"
                          Padding="1">
                    <Image Source="{Binding PortraitImage}"
                           Width="38"
                           Height="38"
                           Stretch="Uniform" />
                  </Border>
                  <TextBlock Text="{Binding ClassName}" FontSize="12" />
                  <TextBlock Text="{Binding HitPointsLabel}" FontSize="12" />
                  <TextBlock Text="{Binding AttacksLabel}" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="RightFormationGrid" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RightGridCells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="3" Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{Binding BorderBrush}"
                      BorderThickness="{Binding BorderThickness}"
                      MinHeight="132"
                      Padding="5"
                      Background="{Binding BackgroundBrush}"
                      PointerPressed="OnGridCellPointerPressed"
                      PointerMoved="OnGridCellPointerMoved"
                      PointerReleased="OnGridCellPointerReleased">
                <StackPanel Spacing="2" HorizontalAlignment="Center" IsVisible="{Binding HasTroop}">
                  <TextBlock Text="{Binding Name}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  <Border BorderBrush="{Binding PortraitBorderBrush}"
                          BorderThickness="{Binding PortraitBorderThickness}"
                          IsVisible="{Binding HasPortrait}"
                          Padding="1">
                    <Image Source="{Binding PortraitImage}"
                           Width="38"
                           Height="38"
                           Stretch="Uniform" />
                  </Border>
                  <TextBlock Text="{Binding ClassName}" FontSize="12" />
                  <TextBlock Text="{Binding HitPointsLabel}" FontSize="12" />
                  <TextBlock Text="{Binding AttacksLabel}" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Button Content="Normal"
                  MinWidth="72"
                  Background="{Binding LeftNormalOrderBackground}"
                  Command="{Binding SetLeftTargetingPreferenceCommand}"
                  CommandParameter="{x:Static enums:TargetingPreference.Normal}" />
          <Button Content="Weakest"
                  MinWidth="72"
                  Background="{Binding LeftWeakestOrderBackground}"
                  Command="{Binding SetLeftTargetingPreferenceCommand}"
                  CommandParameter="{x:Static enums:TargetingPreference.Weakest}" />
          <Button Content="Leader"
                  MinWidth="72"
                  Background="{Binding LeftLeaderOrderBackground}"
                  Command="{Binding SetLeftTargetingPreferenceCommand}"
                  CommandParameter="{x:Static enums:TargetingPreference.Leader}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Button Content="Normal"
                  MinWidth="72"
                  Background="{Binding RightNormalOrderBackground}"
                  Command="{Binding SetRightTargetingPreferenceCommand}"
                  CommandParameter="{x:Static enums:TargetingPreference.Normal}" />
          <Button Content="Weakest"
                  MinWidth="72"
                  Background="{Binding RightWeakestOrderBackground}"
                  Command="{Binding SetRightTargetingPreferenceCommand}"
                  CommandParameter="{x:Static enums:TargetingPreference.Weakest}" />
          <Button Content="Leader"
                  MinWidth="72"
                  Background="{Binding RightLeaderOrderBackground}"
                  Command="{Binding SetRightTargetingPreferenceCommand}"
                  CommandParameter="{x:Static enums:TargetingPreference.Leader}" />
        </StackPanel>
      </Grid>

      <Canvas IsHitTestVisible="False" ClipToBounds="False">
        <Path Data="{Binding AttackArrowPathData}"
              IsVisible="{Binding IsAttackArrowVisible}"
              Stroke="{Binding AttackArrowBrush}"
              StrokeThickness="5"
              StrokeLineCap="Round"
              StrokeJoin="Round" />
        <Image Source="{Binding DraggedPortraitImage}"
               IsVisible="{Binding IsDraggingTroop}"
               Width="48"
               Height="48"
               Stretch="Uniform"
               Canvas.Left="{Binding DraggedPortraitLeft}"
               Canvas.Top="{Binding DraggedPortraitTop}" />
      </Canvas>
    </Grid>

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#999" BorderThickness="1" Padding="10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Battle Log" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding BattleLog}" SelectedItem="{Binding SelectedBattleLogEntry, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Description}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <TextBox Grid.Row="2"
             Grid.ColumnSpan="2"
             Text="{Binding SelectedBattleLogEntry.Description, Mode=OneWay}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="64"
             Watermark="Selected battle log entry" />
  </Grid>
    </TabItem>

    <TabItem Header="Formation Builder">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="320,*,260" ColumnSpacing="16" RowSpacing="12" Margin="0,8,0,0">
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
          <Button Content="New Template" Command="{Binding FormationBuilder.NewTemplateCommand}" />
          <Button Content="Save Template" Command="{Binding FormationBuilder.SaveTemplateCommand}" />
          <TextBlock Text="{Binding FormationBuilder.StatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
          <TextBlock Text="Template" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Name" />
          <TextBox Text="{Binding FormationBuilder.DraftTemplateName, Mode=TwoWay}" />
          <TextBlock Text="Id" />
          <TextBox Text="{Binding FormationBuilder.DraftTemplateId, Mode=TwoWay}"
                   Watermark="Generated from name if left blank" />

          <Separator Margin="0,8,0,4" />

          <TextBlock Text="Add Troop" FontSize="16" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding FormationBuilder.AvailableTroopClasses}"
                    SelectedItem="{Binding FormationBuilder.SelectedTroopClass, Mode=TwoWay}" />
          <Button Content="Add Troop" Command="{Binding FormationBuilder.AddTroopCommand}" />
          <Button Content="Remove Selected" Command="{Binding FormationBuilder.RemoveSelectedTroopCommand}" />

          <Separator Margin="0,8,0,4" />

          <TextBlock Text="Validation" FontSize="16" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding FormationBuilder.ValidationMessages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#B00020" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Text="Formation" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Grid.Row="1" Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="Front" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Local formation faces this direction before Blue/Red side mirroring."
                       FontSize="11"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="4" HorizontalAlignment="Center">
            <Grid x:Name="BuilderGridLayer" Width="390" Height="390">
              <Border BorderBrush="#555" BorderThickness="1" Background="White">
                <ItemsControl x:Name="BuilderFormationGrid"
                              ItemsSource="{Binding FormationBuilder.FormationGridCells}"
                              Width="390"
                              Height="390">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="3" Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="130"
                              Height="130"
                              Padding="6"
                              Background="{Binding Background}"
                              BorderBrush="{Binding BorderBrush}"
                              BorderThickness="1"
                              PointerPressed="OnBuilderCellPointerPressed"
                              PointerMoved="OnBuilderCellPointerMoved"
                              PointerReleased="OnBuilderCellPointerReleased">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                          <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="112">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <Image Source="{Binding PortraitImage}"
                                   Width="44"
                                   Height="44"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding HasPortrait}" />
                            <TextBlock Text="{Binding ClassName}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="Leader"
                                       FontSize="11"
                                       Foreground="#8A5A00"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding IsLeader}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Canvas IsHitTestVisible="False">
                <Image Source="{Binding FormationBuilder.DraggedPortraitImage}"
                       IsVisible="{Binding FormationBuilder.IsDraggingTroop}"
                       Width="48"
                       Height="48"
                       Stretch="Uniform"
                       Canvas.Left="{Binding FormationBuilder.DraggedPortraitLeft}"
                       Canvas.Top="{Binding FormationBuilder.DraggedPortraitTop}" />
              </Canvas>
            </Grid>
            <TextBlock Grid.Row="1" Text="Back" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Text="Troops" FontSize="18" FontWeight="SemiBold" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding FormationBuilder.DraftTroops}"
                   SelectedItem="{Binding FormationBuilder.SelectedDraftTroop, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="4" Margin="0,4">
                  <TextBox Text="{Binding Name, Mode=TwoWay}" />
                  <TextBlock Text="{Binding ClassName}" FontSize="12" />
                  <TextBlock Text="{Binding SlotId}" FontSize="11" Foreground="#666" />
                  <CheckBox Content="Leader" IsChecked="{Binding IsLeader, Mode=TwoWay}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
